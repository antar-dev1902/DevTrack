# Optional: External Backend Authentication API URL
# When configured, DevTrack routes signup/login requests to this endpoint instead of standalone Web Crypto mode.
# Example: https://api.devtrack.example.com
VITE_AUTH_API_URL=

# Optional: Supabase / Firebase / Third-Party Provider Configuration (if integrating external providers)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
